# ---------------------------------------------------------------------------
# Backend environment configuration. Loaded automatically by src/server.js.
# ---------------------------------------------------------------------------

# Server
PORT=5000
NODE_ENV=development

# MongoDB connection string
MONGODB_URI=mongodb://localhost:27017/logic-gate-simulator

# Auth — REQUIRED. Replace before deploying to production.
# Generate a strong value with: openssl rand -hex 32
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRE=7d

# Comma-separated list of allowed browser origins
CLIENT_URL=http://localhost:5173

# Request body ceiling (circuits are stored as JSON)
JSON_BODY_LIMIT=5mb

